{
  "name": "tig-core",
  "private": false,
  "license": "MIT",
  "version": "3.0.0",
  "description": "TypeScript In Games Core",
  "author": "Funny002<2048412928@qq.com>",
  "main": "./libs/index.umd.js",
  "module": "./libs/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./libs/index.mjs",
      "require": "./libs/index.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Funny002/TIG-Core.git"
  },
  "bugs": {
    "url": "https://github.com/Funny002/TIG-Core/issues"
  },
  "homepage": "https://github.com/Funny002/TIG-Core#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "serve": "node tools/serve.mjs",
    "devtools:mcp": "node node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js --headless --no-usage-statistics --allow-unrestricted-paths",
    "devtools:demo": "node tools/devtools-client.mjs",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "color": "^5.0.3",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-devtools-mcp": "^1.7.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "files": [
    "libs/*",
    "docs/*",
    "types/*",
    "*.json",
    "*.js",
    "*.md",
    "LICENSE"
  ]
}
